+=item C<copy_file ($from, $to)>
+
+Copy C<$from> to C<$to>, preserving its permission bits.  Returns true on
+success and false on failure, with C<$!> set.
+
+=cut
+
+# &copy_file ($FROM, $TO)
+# -----------------------
+#
+# Upstream shelled out to cp(1) for this.  Doing it in Perl means automake and
+# aclocal need no POSIX toolbox on PATH, which matters when they run inside a
+# build sandbox.  File::Copy::copy does not carry the mode over and several of
+# the files automake installs are scripts, so set it by hand.
+sub copy_file ($$)
+{
+  my ($from, $to) = @_;
+  return 0
+    unless File::Copy::copy ($from, $to);
+  my $mode = (stat $from)[2];
+  return 1
+    unless defined $mode;
+  return chmod ($mode & 07777, $to) ? 1 : 0;
+}
