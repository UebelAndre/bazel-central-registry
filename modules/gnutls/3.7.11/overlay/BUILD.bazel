"""Bazel build for GnuTLS — TLS/SSL library.

Ported from configure.ac and lib/**/Makefile.am (gnutls-3.7.11).
Scope: core libgnutls only — no `src/` CLI tools, no libdane, no C++
binding, no guile, no test suite. Optional feature toggles listed in
`Feature flags` below mirror the autoconf --enable-*/--disable-* switches
users would set at ./configure time.
"""

load("@bazel_skylib//rules:common_settings.bzl", "bool_flag", "string_flag")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc_autoconf//autoconf:autoconf.bzl", "autoconf")
load("@rules_cc_autoconf//autoconf:autoconf_hdr.bzl", "autoconf_hdr")
load("@rules_cc_autoconf//autoconf:checks.bzl", "checks", "macros")
load("@rules_cc_autoconf//autoconf:package_info.bzl", "package_info")
load("//bazel:gperf_static.bzl", "gperf_static")

# gnutls.h.in expects @VERSION@, @MAJOR_VERSION@, @MINOR_VERSION@,
# @PATCH_VERSION@, @NUMBER_VERSION@. Configure.ac derives them from
# PACKAGE_VERSION via sed at bootstrap time; here we mirror them by
# hand — keep in sync with MODULE.bazel's `version = "3.7.11"`.
_VERSION = "3.7.11"

_MAJOR_VERSION = "3"

_MINOR_VERSION = "7"

_PATCH_VERSION = "11"

# 0x030700 + patch (autotools formula: printf '0x%02x%02x%02x')
_NUMBER_VERSION = "0x03070b"

# =============================================================================
# Feature flags — public knobs mapped from configure.ac --enable/--with.
# =============================================================================

# --with-zlib / --without-zlib (default disabled here; upstream default
# is enabled but we don't want to force a zlib link on every consumer).
bool_flag(
    name = "use_zlib",
    build_setting_default = False,
    visibility = ["//visibility:public"],
)

# --disable-hardware-acceleration (default enabled). Reserved for the
# eventual x86/aarch64 asm port; currently no-op — plain C used
# everywhere so this only affects the ENABLE_HARDWARE_ACCELERATION
# define, not what sources compile.
bool_flag(
    name = "use_hw_accel",
    build_setting_default = True,
    visibility = ["//visibility:public"],
)

# --disable-gost (default enabled). Gates GOST curve/cipher sources
# under lib/nettle/gost/ plus a couple of top-level files.
bool_flag(
    name = "enable_gost",
    build_setting_default = True,
    visibility = ["//visibility:public"],
)

# TLS feature toggles — one per `AC_ARG_ENABLE` in configure.ac. All
# default on to match `./configure` with no flags.
bool_flag(
    name = "enable_srp",
    build_setting_default = True,
    visibility = ["//visibility:public"],
)

bool_flag(
    name = "enable_psk",
    build_setting_default = True,
    visibility = ["//visibility:public"],
)

bool_flag(
    name = "enable_ocsp",
    build_setting_default = True,
    visibility = ["//visibility:public"],
)

bool_flag(
    name = "enable_alpn",
    build_setting_default = True,
    visibility = ["//visibility:public"],
)

bool_flag(
    name = "enable_dtls_srtp",
    build_setting_default = True,
    visibility = ["//visibility:public"],
)

bool_flag(
    name = "enable_heartbeat",
    build_setting_default = True,
    visibility = ["//visibility:public"],
)

# --with-default-priority-string=STR (default "NORMAL"). Baked into
# lib/priority.c via config.h.
string_flag(
    name = "default_priority_string",
    build_setting_default = "NORMAL",
    visibility = ["//visibility:public"],
)

# --with-pkcs12-iter-count=N (default 600000).
string_flag(
    name = "pkcs12_iter_count",
    build_setting_default = "600000",
    visibility = ["//visibility:public"],
)

# --with-system-priority-file=PATH (default /etc/gnutls/config).
string_flag(
    name = "system_priority_file",
    build_setting_default = "/etc/gnutls/config",
    visibility = ["//visibility:public"],
)

# =============================================================================
# config_setting mirrors
# =============================================================================

[
    config_setting(
        name = "{}_enabled".format(flag),
        flag_values = {":" + flag: "True"},
    )
    for flag in [
        "use_zlib",
        "use_hw_accel",
        "enable_gost",
        "enable_srp",
        "enable_psk",
        "enable_ocsp",
        "enable_alpn",
        "enable_dtls_srtp",
        "enable_heartbeat",
    ]
]

# =============================================================================
# autoconf / autoconf_hdr
# =============================================================================

package_info(
    name = "package",
    aliases = {
        "PACKAGE": "PACKAGE_NAME",
    },
    module_bazel = "MODULE.bazel",
    strip_bcr_version = True,
)

autoconf(
    name = "configure_ac",
    checks = macros.AC_CHECK_HEADERS([
        "netinet/tcp.h",
        "stdatomic.h",
        "threads.h",
        "sanitizer/asan_interface.h",
        "valgrind/memcheck.h",
    ]) + macros.AC_CHECK_FUNCS([
        "fork",
        "setitimer",
        "getrusage",
        "getpwuid_r",
        "nanosleep",
        "daemon",
        "getpid",
        "localtime",
        "mmap",
        "__register_atfork",
        "secure_getenv",
        "getauxval",
        "clock_gettime",
        "fmemopen",
    ]) + [
        # nettle-optional functions upstream probes via AC_CHECK_FUNCS.
        # nettle 3.9.1's public headers include the first two but not
        # the GOST28147/Magma/Kuznyechik families (they live in a
        # separate crypto-experimental branch upstream). When the
        # HAVE_NETTLE_* macro is unset, gnutls compiles its bundled
        # copy under lib/nettle/gost/ instead — the ENABLE_GOST flag
        # brings those .c files into srcs and their headers into the
        # include path.
        checks.AC_DEFINE(
            "HAVE_NETTLE_RSA_SEC_DECRYPT",
            value = "1",
        ),
        checks.AC_DEFINE(
            "HAVE_NETTLE_STREEBOG512_UPDATE",
            value = "1",
        ),
        # Version substitutions for lib/includes/gnutls/gnutls.h.in.
        checks.AC_SUBST("VERSION", _VERSION),
        checks.AC_SUBST("MAJOR_VERSION", _MAJOR_VERSION),
        checks.AC_SUBST("MINOR_VERSION", _MINOR_VERSION),
        checks.AC_SUBST("PATCH_VERSION", _PATCH_VERSION),
        checks.AC_SUBST("NUMBER_VERSION", _NUMBER_VERSION),
        # struct iovec: on POSIX include <sys/uio.h> and typedef it as
        # giovec_t; on Windows define a compatible struct inline.
        # Matches configure.ac's AC_CHECK_MEMBERS([struct iovec.iov_base]).
    ] + select({
        "@platforms//os:windows": [
            checks.AC_SUBST(
                "DEFINE_IOVEC_T",
                "typedef struct { void *iov_base; size_t iov_len; } giovec_t;",
            ),
        ],
        "//conditions:default": [
            checks.AC_SUBST(
                "DEFINE_IOVEC_T",
                "#include <sys/uio.h>\ntypedef struct iovec giovec_t;",
            ),
        ],
    }) + [
        # Explicit sizes — see libtasn1 overlay for rationale.
        checks.AC_DEFINE(
            "SIZEOF_UNSIGNED_INT",
            value = "4",
        ),
        checks.AC_DEFINE(
            "SIZEOF_TIME_T",
            value = "8",
        ),
        # struct iovec.iov_base member — universally present on POSIX.
        checks.AC_DEFINE(
            "HAVE_STRUCT_IOVEC_IOV_BASE",
            value = "1",
        ),
    ] + select({
        "@platforms//os:windows": [
            checks.AC_DEFINE(
                "SIZEOF_UNSIGNED_LONG_INT",
                value = "4",
            ),
        ],
        "//conditions:default": [
            checks.AC_DEFINE(
                "SIZEOF_UNSIGNED_LONG_INT",
                value = "8",
            ),
        ],
    }),
    deps = [":package"],
)

autoconf_hdr(
    name = "config_h",
    out = "config.h",
    template = "config.h.in",
    deps = [":configure_ac"],
)

autoconf_hdr(
    name = "gnutls_h",
    out = "lib/includes/gnutls/gnutls.h",
    mode = "subst",
    template = "lib/includes/gnutls/gnutls.h.in",
    deps = [":configure_ac"],
)

# =============================================================================
# gperf-generated tables
# =============================================================================
#
# gnutls's priority-string parser and X.509 extension recognizer are
# perfect-hash lookups compiled from .gperf sources. //bazel:gperf_static
# runs `gperf` (from the @gperf//:gperf module) and then rewrites the
# exported lookup table symbol to `static`, matching upstream's
# `gperf ... | sed` pipeline without needing a shell.

gperf_static(
    name = "gen_priority_options_h",
    src = "lib/priority_options.gperf",
    out = "lib/priority_options.h",
    struct_name = "priority_options_st",
)

gperf_static(
    name = "gen_supported_exts_h",
    src = "lib/x509/supported_exts.gperf",
    out = "lib/x509/supported_exts.h",
    struct_name = "supported_exts_st",
)

# =============================================================================
# Feature-driven local_defines
# =============================================================================
#
# Each flag maps to a compile-time -D that mirrors what configure.ac
# would put in config.h. Keeping this in `local_defines` (rather than
# an autoconf(select(...))) keeps the flag → source-list gating and
# flag → define gating in one place per feature.
FEATURE_DEFINES = select({
    ":enable_srp_enabled": ["ENABLE_SRP"],
    "//conditions:default": [],
}) + select({
    ":enable_psk_enabled": ["ENABLE_PSK"],
    "//conditions:default": [],
}) + select({
    ":enable_ocsp_enabled": ["ENABLE_OCSP"],
    "//conditions:default": [],
}) + select({
    ":enable_alpn_enabled": ["ENABLE_ALPN"],
    "//conditions:default": [],
}) + select({
    ":enable_dtls_srtp_enabled": ["ENABLE_DTLS_SRTP"],
    "//conditions:default": [],
}) + select({
    ":enable_heartbeat_enabled": ["ENABLE_HEARTBEAT"],
    "//conditions:default": [],
}) + select({
    ":enable_gost_enabled": ["ENABLE_GOST"],
    "//conditions:default": [],
}) + select({
    ":use_zlib_enabled": ["HAVE_LIBZ"],
    "//conditions:default": [],
}) + select({
    ":use_hw_accel_enabled": ["ENABLE_HARDWARE_ACCELERATION"],
    "//conditions:default": [],
})

# Simple integer-valued flag define — safe in local_defines.
STRING_FLAG_DEFINES = [
    "PKCS12_ITER_COUNT=600000",
]

# String-valued defines go through copts (Bazel's local_defines rejects
# tokens containing spaces, which the shell-quoted string values here
# would produce). One `-D` per entry, with backslash-quoted strings.
STRING_FLAG_COPTS = [
    '-DDEFAULT_PRIORITY_STRING=\\"NORMAL\\"',
    '-DSYSTEM_PRIORITY_FILE=\\"/etc/gnutls/config\\"',
    # Legacy autotools synonym for PACKAGE_VERSION — config.h emits the
    # latter (from package_info) but not this one.
    '-DVERSION=\\"' + _VERSION + '\\"',
    # SONAMEs and feature strings surfaced by gnutls_check_version() /
    # the "hardware-features"/"tls-features" info keys. Autotools
    # computes each SONAME from libtool versioning; hardcode here —
    # nothing runtime-critical parses them.
    '-DGNUTLS_LIBRARY_SONAME=\\"libgnutls.so.30\\"',
    '-DNETTLE_LIBRARY_SONAME=\\"libnettle.so.8\\"',
    '-DHOGWEED_LIBRARY_SONAME=\\"libhogweed.so.6\\"',
    '-DGMP_LIBRARY_SONAME=\\"libgmp.so.10\\"',
    '-DHW_FEATURES=\\"none\\"',
    '-DTLS_FEATURES=\\"\\"',
]

