    name = "gnutls",
    srcs = LIB_CORE_SRCS + LIB_AUTH_SRCS_BASE + LIB_ALGORITHMS_SRCS +
           LIB_EXT_SRCS_BASE + LIB_X509_SRCS_BASE + LIB_NETTLE_BASE_SRCS +
           LIB_TLS13_SRCS + LIB_EXTRAS_SRCS + GL_SRCS + INTERNAL_HDRS + [
        ":config_h",
        ":gen_priority_options_h",
        ":gen_supported_exts_h",
    ] + LIB_NETTLE_RNG_SRCS + LIB_SYSTEM_KEYS_SRCS + select({
        ":enable_gost_enabled": LIB_NETTLE_GOST_SRCS + [
            "lib/auth/vko_gost.c",
            "lib/vko.c",
        ],
        "//conditions:default": [],
    }) + select({
        ":enable_ocsp_enabled": [
            "lib/x509/ocsp.c",
