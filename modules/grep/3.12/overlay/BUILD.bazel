    name = "lib_wchar_h",
    out = "lib/wchar.h",
    defaults = True,
    inlines = GL_INLINES,
    mode = "subst",
    substitutions = select({
        "@rules_cc//cc/compiler:clang-cl": {
            "@REPLACE_MBSINIT@": "1",
