        ":lib/grep_gnulib_conditional_srcs",
    ],
    copts = COPTS,
    implementation_deps = [":lib/grep_private_headers"],
    linkopts = select({
        # lib/stat-w32.c and lib/windows-*.c pull in Win32 APIs that MSVC
        # does not link by default.
        "@rules_cc//cc/compiler:msvc-cl": ["/DEFAULTLIB:advapi32.lib"],
        "//conditions:default": [],
    }),
    local_defines = LOCAL_DEFINES,
    textual_hdrs = LIBGREP_GNULIB_TEXTUAL_HDRS,
    # `tests/get-mb-cur-max` is upstream's `check_PROGRAMS` helper and links
    # against libgreputils.a exactly like `src/grep` does.
    visibility = ["//tests:__pkg__"],
)

autoconf_linkopts(
    name = "linkopts",
    vars = [
        "HARD_LOCALE_LIB",
        "LIBC32CONV",
        "LIBCSTACK",
        "LIBINTL",
        "LIBSIGSEGV",
        "LIBTHREAD",
        "LIBUNISTRING",
        "MBRTOWC_LIB",
        "SETLOCALE_NULL_LIB",
    ],
    visibility = ["//tests:__pkg__"],
    deps = [":autoconf"],
)

# Build targets (from src/Makefile.am)

cc_binary(
    name = "src/grep",
    srcs = [
        "src/dfasearch.c",
        "src/grep.c",
        "src/kwsearch.c",
        "src/kwset.c",
        "src/searchutils.c",
    ] + glob([
        "src/*.h",
    ]) + select({
        ":perl_regexp_enabled": ["src/pcresearch.c"],
        "//conditions:default": [],
    }),
    copts = COPTS,
    # `src` must precede `lib` so `#include <search.h>` finds `src/search.h`
    # instead of the host's `<search.h>`.
    # do not sort
    includes = [
        "src",
        "lib",
    ],
    local_defines = LOCAL_DEFINES,
    target_compatible_with = select({
        "@platforms//os:none": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    visibility = ["//visibility:public"],
    deps = [
        ":lib/grep",
        ":lib/grep_private_headers",
        ":linkopts",
    ] + select({
        ":perl_regexp_enabled": ["@pcre2"],
        "//conditions:default": [],
    }),
)

alias(
    name = "grep",
    actual = ":src/grep",
    visibility = ["//visibility:public"],
)

alias(
    name = "bin/grep",
    actual = ":src/grep",
    visibility = ["//visibility:public"],
)

alias(
    name = "grep_bin",
    actual = ":src/grep",
    visibility = ["//visibility:public"],
)

# Skipped macros (no Bazel equivalent needed):
#
# configure.ac:
#   AC_ARG_ENABLE([gcc-warnings]) (line 90) - the port silences every
#     warning via COPTS instead, so the -W flag battery has no effect.
#   AM_GNU_GETTEXT([external]) (line 118) - there is no gettext module in
#     the BCR, so NLS is always off and LIBINTL is empty.
#   AM_CONDITIONAL([USE_INCLUDED_REGEX]) (line 127) - rules_cc_autoconf's
#     gnulib/m4/regex pins ac_use_included_regex=yes, matching grep's own
#     default, so there is nothing left to toggle.
#   gl_EARLY / gl_INIT (lines 51, 120) - expanded by GNULIB_M4_DEPS.
#   AC_CONFIG_FILES / AC_OUTPUT (lines 214-237) - the Makefile.in ->
#     Makefile expansion has no analogue here.
#   gl_cv_func_mbrtowc_empty_input / gl_cv_func_mbrlen_empty_input
#     (lines 70-71) - configure.ac pre-seeds these to skip AC_RUN_IFELSE
#     probes; rules_cc_autoconf reaches the same answers without running
#     target code.
#
# m4/pcre.m4:
#   PKG_CHECK_MODULES([PCRE], [libpcre2-8]) (line 20) - replaced by the
#     bazel_dep on @pcre2.
#   The pcre2_compile link probe (lines 24-40) - @pcre2//:pcre2 is a
#     first-party BCR module, so the library is known to be present.
