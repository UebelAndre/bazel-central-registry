# src/system.h is the only consumer and only reads LOCALEDIR, which is dead
# weight here because NLS is always off (no gettext module in the BCR).
write_file(
    name = "configmake_h",
    out = "lib/configmake.h",
    content = [
        "/* Generated by Bazel in place of lib/configmake.h. */",
        "#ifndef LOCALEDIR",
        "# define LOCALEDIR \"/usr/share/locale\"",
        "#endif",
        "#ifndef GNULIB_LOCALEDIR",
        "# define GNULIB_LOCALEDIR \"/usr/share/locale\"",
