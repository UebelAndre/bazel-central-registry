autoconf(
    name = "autoconf",
    checks = [
        checks.AC_SUBST(
            "GUARD_PREFIX",
            value = "GL",
        ),
        # configure.ac line 54
        checks.AC_DEFINE("GREP", 1),
        # configure.ac lines 61-64: argmatch.c calls back into
        # src/grep.c's usage() on a bad --directories= etc. value.
        checks.AC_DEFINE(
            "ARGMATCH_DIE",
            value = "usage (EXIT_FAILURE)",
        ),
        checks.AC_DEFINE(
            "ARGMATCH_DIE_DECL",
            value = "void usage (int _e)",
        ),
        # gnulib's unlocked-io module (lib/gnulib.mk).
        checks.AC_DEFINE(
            "USE_UNLOCKED_IO",
            value = "GNULIB_STDIO_SINGLE_THREAD",
        ),
        # gl_FUNC_ERROR derives COMPILE_ERROR_C, which
        # rules_cc_autoconf's error module does not surface (TODO: it
        # should, and then this check can go).  glibc
        # supplies both entry points unreplaced; everywhere else
        # gnulib's lib/error.c has to be compiled in.
        checks.AC_SUBST(
            "COMPILE_ERROR_C",
            condition = "HAVE_ERROR==1 && HAVE_ERROR_AT_LINE==1 && REPLACE_ERROR==0 && REPLACE_ERROR_AT_LINE==0",
            if_false = "1",
            if_true = "0",
        ),
        # configure.ac line 82
        checks.AC_SUBST("USES_MSVCRT", "0"),
    ] + macros.AC_CHECK_FUNCS([
        # configure.ac line 80
        "setlocale",
    ]) + [
        checks.AC_SUBST(
            name,
            value = value,
        )
        for name, value in GNULIB_MODULE_INDICATORS.items()
    ] + [
        checks.AC_DEFINE(name, value)
        for name, value in GNULIB_MODULE_INDICATORS.items()
    ],
    deps = [
        ":m4_c32rtomb",
        ":m4_langinfo",
        ":m4_largefile",
        ":m4_pcre",
        ":m4_year2038",
        ":package",
        "@rules_cc_autoconf//autoconf/macros/AC_TYPE_SIZE_T",
    ] + GNULIB_M4_DEPS,
)

