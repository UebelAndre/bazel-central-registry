COPTS = select({
    # grep's gnulib copy needs C11 for `static_assert`, `_Noreturn` and
    # `char32_t`; `/w` and `-w` silence every warning the port would
    # otherwise inherit from upstream's -Wall-heavy default CFLAGS.
    "@rules_cc//cc/compiler:clang-cl": [
        "/w",
        "/std:c11",
    ],
    "@rules_cc//cc/compiler:msvc-cl": [
        "/w",
        "/std:c11",
    ],
    "//conditions:default": [
        "-w",
        "-std=gnu11",
    ],
})

LOCAL_DEFINES = [
    "HAVE_CONFIG_H",
    # Several gnulib lib/*.c files use bare C11 `static_assert` without
    # including <assert.h>; surface the keyword mapping directly so config.h
    # doesn't need to gate on HAVE_C_STATIC_ASSERT.
    "static_assert=_Static_assert",
] + select({
    # gnulib's stddef.h polyfill for C23 `unreachable()` is gated on
    # HAVE_C_UNREACHABLE, which rules_cc_autoconf probes with a C23 compiler
    # while grep itself compiles at gnu11.  Map onto the compiler builtin.
    "@rules_cc//cc/compiler:clang-cl": [
        "unreachable()=__assume(0)",
        "AVOID_ANY_THREADS=1",
    ],
    "@rules_cc//cc/compiler:msvc-cl": [
        "unreachable()=__assume(0)",
        # lib/setlocale_null.c hardcodes a __declspec(dllimport) extern for
        # gl_get_setlocale_null_lock that the static-link build of
        # setlocale-lock.c has no matching dllexport for.  AVOID_ANY_THREADS
        # collapses the locking branch before that extern is seen.
        "AVOID_ANY_THREADS=1",
    ],
    "//conditions:default": [
        "unreachable=__builtin_unreachable",
    ],
})

