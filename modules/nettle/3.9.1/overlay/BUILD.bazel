"""Bazel build for GNU Nettle — low-level crypto library.

Ported from Makefile.in and configure.ac (nettle-3.9.1).
Scope: portable C sources for libnettle (symmetric crypto) and libhogweed
(public-key crypto). Assembly optimizations under x86_64/, arm64/, arm/,
etc. are deliberately not compiled here — the plain-C sources cover the
whole API; a follow-up can gate them behind a `use_asm` flag.
"""

load("@bazel_skylib//rules:common_settings.bzl", "bool_flag")
load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc_autoconf//autoconf:autoconf.bzl", "autoconf")
load("@rules_cc_autoconf//autoconf:autoconf_hdr.bzl", "autoconf_hdr")
load("@rules_cc_autoconf//autoconf:checks.bzl", "checks", "macros")
load("@rules_cc_autoconf//autoconf:package_info.bzl", "package_info")
load("//bazel:eccdata_gen.bzl", "eccdata_gen")

# version.h.in expects @MAJOR_VERSION@, @MINOR_VERSION@, plus
# @NETTLE_USE_MINI_GMP@ and @GMP_NUMB_BITS@. Configure.ac derives the
# first two from PACKAGE_VERSION via sed at bootstrap time; here we
# mirror them by hand — keep in sync with MODULE.bazel's
# `version = "3.9.1"`. We build against the real GMP module, never
# mini-gmp, so NETTLE_USE_MINI_GMP is 0.
_MAJOR_VERSION = "3"

_MINOR_VERSION = "9"

# Feature flag: `--enable-mini-gmp` in autotools. Kept off — we depend
# on the registered `@gmp` module (bundling mini-gmp would duplicate
# 100k lines of arithmetic already present via that dep).
bool_flag(
    name = "use_mini_gmp",
    build_setting_default = False,
    visibility = ["//visibility:public"],
)

package_info(
    name = "package",
    aliases = {
        "PACKAGE": "PACKAGE_NAME",
    },
    module_bazel = "MODULE.bazel",
    strip_bcr_version = True,
)

# Feature checks matching configure.ac's AC_CHECK_HEADERS /
# AC_CHECK_FUNCS / AC_CHECK_SIZEOF. openssl/*.h are only used by
# nettle's optional benchmark tools, which we don't build; skip.
autoconf(
    name = "configure_ac",
    checks = macros.AC_CHECK_HEADERS([
        "dlfcn.h",
    ]) + macros.AC_CHECK_FUNCS([
        "secure_getenv",
        "getline",
    ]) + [
        # sizeof(long) — 4 on Windows LLP64, 8 on Unix LP64.
        # sizeof(size_t) — matches the pointer width.
        # nettle only reads SIZEOF_LONG; hardcode via select.
        checks.AC_SUBST("MAJOR_VERSION", _MAJOR_VERSION),
        checks.AC_SUBST("MINOR_VERSION", _MINOR_VERSION),
        checks.AC_SUBST("NETTLE_USE_MINI_GMP", "0"),
        # Only used when NETTLE_USE_MINI_GMP is truthy; still needs to
        # produce a valid C token so the preprocessor doesn't choke.
        checks.AC_SUBST("GMP_NUMB_BITS", "64"),
        # Nettle looks for these HAVE_NATIVE_* flags to detect
        # architecture-specific optimizations we're deliberately not
        # compiling; leave them all undefined (autoconf_hdr defaults
        # unset `#undef` lines).
    ] + select({
        "@platforms//os:windows": [
            checks.AC_DEFINE("SIZEOF_LONG", value = "4"),
            checks.AC_DEFINE("SIZEOF_SIZE_T", value = "8"),
        ],
        "//conditions:default": [
            checks.AC_DEFINE("SIZEOF_LONG", value = "8"),
            checks.AC_DEFINE("SIZEOF_SIZE_T", value = "8"),
        ],
    }),
    deps = [":package"],
)

autoconf_hdr(
    name = "config_h",
    out = "config.h",
    template = "config.h.in",
    deps = [":configure_ac"],
)

autoconf_hdr(
    name = "version_h",
    out = "version.h",
    mode = "subst",
    template = "version.h.in",
    deps = [":configure_ac"],
)

# =============================================================================
# eccdata bootstrap tool + generated ECC tables
# =============================================================================
#
# Nettle ships eccdata.c, a small program that, when run, prints a
# curve-specific header of precomputed points. libhogweed's ECC
# implementations `#include` those headers. Autotools builds eccdata as
# a host-only binary, then runs it once per curve. We mirror that:
# eccdata is a cc_binary; each curve's header is generated by an
# eccdata_gen rule (see //bazel:eccdata_gen.bzl) that captures
# eccdata's stdout to a file via a cross-platform helper.
#
# NUMB_BITS = 64 (matches GMP on every 64-bit target Bazel supports;
# for the eventual 32-bit port, switch on select({... 32-bit: 32, ...})).
_NUMB_BITS = 64

_ECC_CURVES = {
    "ecc-secp192r1.h": ("secp192r1", 8, 6),
    "ecc-secp224r1.h": ("secp224r1", 16, 7),
    "ecc-secp256r1.h": ("secp256r1", 11, 6),
    "ecc-secp384r1.h": ("secp384r1", 32, 6),
    "ecc-secp521r1.h": ("secp521r1", 44, 6),
    "ecc-curve25519.h": ("curve25519", 11, 6),
    "ecc-curve448.h": ("curve448", 38, 6),
    "ecc-gost-gc256b.h": ("gost_gc256b", 11, 6),
    "ecc-gost-gc512a.h": ("gost_gc512a", 43, 6),
}

# eccdata.c does `#include "mini-gmp.c"`, so mini-gmp.c must be a
# textual header rather than a compiled source; cc_binary doesn't accept
# textual_hdrs, so we wrap them in a cc_library first.
cc_library(
    name = "_eccdata_mini_gmp",
    textual_hdrs = [
        "mini-gmp.c",
        "mini-gmp.h",
    ],
)

cc_binary(
    name = "eccdata",
    srcs = ["eccdata.c"],
    deps = [":_eccdata_mini_gmp"],
)

[
    eccdata_gen(
        name = "gen_" + out.replace(".", "_"),
        out = out,
        c = c,
        curve = curve,
        k = k,
        numb_bits = _NUMB_BITS,
    )
    for out, (curve, k, c) in _ECC_CURVES.items()
]

